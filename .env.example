# --- Local stdio mode (Claude Desktop / Cursor, single user) ---
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-access-token

# --- Remote http mode ---
# MCP_TRANSPORT=http
# PORT=8080
# PUBLIC_BASE_URL=https://hubspot-mcp.example.com
# OAUTH_ISSUER=https://your-org.okta.com/oauth2/default
# OAUTH_JWKS_URI=https://your-org.okta.com/oauth2/default/v1/keys   # default: $OAUTH_ISSUER/.well-known/jwks.json
# OAUTH_AUDIENCE=https://hubspot-mcp.example.com/mcp                # default: $PUBLIC_BASE_URL/mcp
# OAUTH_TENANT_CLAIM=tenant_id
# TENANTS_FILE=./tenants.json          # or TENANTS_JSON='{"acme":{"hubspotTokenEnv":"HUBSPOT_TOKEN_ACME"}}'
# HUBSPOT_TOKEN_ACME=pat-xxxx          # one per tenant; inject from your secret manager
# ALLOWED_ORIGINS=                     # comma-separated browser origins; empty = reject all browser origins

# --- Guardrails ---
# REQUIRE_APPROVAL=true                # default true in http mode, false in stdio
# APPROVAL_TTL_SECONDS=86400
# APPROVAL_WEBHOOK_URL=https://hooks.slack.com/services/...
# RATE_LIMIT_READ_PER_MIN=60
# RATE_LIMIT_WRITE_PER_MIN=10
# RATE_LIMIT_TENANT_PER_MIN=300
# RATE_LIMIT_IP_PER_MIN=300
# AUDIT_LOG_FILE=./audit.jsonl         # stderr JSON is always emitted
# AUDIT_REDACT_PII=true
